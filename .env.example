# Copy this file to .env.local and fill in what you have.
#
# This is a private, single-owner app. Searching and every other server feature stay CLOSED until the three
# "Sign-in" values below are set (docs/security-hardening.md). Everything after "Optional" can be left empty.

# --- Sign-in (required) -----------------------------------------------------
# Your Supabase project. These two NEXT_PUBLIC values are public by design (row-level security protects the data),
# but they are fixed when the site is built, so set them BEFORE deploying.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Your own account's id: Supabase dashboard, Authentication, Users, "UID". Nobody else is let in.
OWNER_USER_ID=

# --- Optional: paid Claude features. OFF unless AI_ENABLED=1 AND a key is set --
# Leave both empty to pay nothing: matching then uses the built-in rules.
# AI_ENABLED=1
# https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-sonnet-4-5, which Anthropic retires
# on 2026-11-30. After that the app switches to claude-sonnet-5-5 by itself.
# Set this to skip the failed first call.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Live jobs, option A: Adzuna (tried first) ------------------------------
# https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Live jobs, option B: JSearch on RapidAPI -------------------------------
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# --- Search tuning (optional) ----------------------------------------------
# How many of the best rule-ranked jobs Claude reviews per search, 0 to 60. Default 20; 0 turns it off.
# AI_SHORTLIST=20
# "fallback" (default) uses the first job source that answers. "all" queries every configured
# source at once and merges them, which uses quota on each.
# JOB_PROVIDER_MODE=fallback

# --- Development only -------------------------------------------------------
# `npm run dev` shows clearly labelled, invented sample jobs when no job-board key
# is set. A production build never does. Set this to 1 to allow them there too.
# CMH_DEMO=1

# --- Cloud sync and the 8:00 AM morning run (all optional) --------------------
# The sign-in values above are also used for sync. Sync stays off until you turn it on in the app.
# SERVER ONLY. Never give this a NEXT_PUBLIC name and never commit it. It bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=
# A long random string (at least 16 characters). Also add it as the CRON_SECRET repository secret on GitHub.
CRON_SECRET=
# Comma-separated sign-in emails that get a morning run. Anyone else is ignored, so a stranger
# cannot spend your job-board quota.
DAILY_RUN_EMAILS=
# Optional. Job-board calls per morning, 1 to 30. Default 12.
# DAILY_MAX_SEARCHES=12

# --- HR & Recruiter Finder web lookups (paid; needs AI_ENABLED, the key and the switch below) ---
# Web lookups bill Anthropic per search. Lookups allowed per server instance per hour, 1 to 200. Default 20.
# FIND_RECRUITER_MAX_PER_HOUR=20
# Turns on paid web lookups for recruiters. Off by default.
# RECRUITER_WEB_SEARCH=1

# Optional. Seconds the morning run may spend before it stops and saves (default 200). Keep it below your function time limit.
# DAILY_BUDGET_SECONDS=200
# Optional server-side alias of NEXT_PUBLIC_SUPABASE_URL.
# SUPABASE_URL=
