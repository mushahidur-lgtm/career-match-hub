# Copy this file to .env.local and fill in what you have.
# Every key is optional. Without a job-board key a deployed site finds no jobs:
# it never invents listings.

# --- Claude: resume analysis and AI match scoring ---------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-sonnet-4-5, which Anthropic retires
# on 2026-11-30. After that the app switches to claude-sonnet-5-5 by itself.
# Set this to skip the failed first call.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Live jobs, option A: Adzuna (tried first) ------------------------------
# https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Live jobs, option B: JSearch on RapidAPI -------------------------------
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# --- Development only -------------------------------------------------------
# `npm run dev` shows clearly labelled, invented sample jobs when no job-board key
# is set. A production build never does. Set this to 1 to allow them there too.
# CMH_DEMO=1
